{
  "name": "screenshare-relay",
  "version": "1.7.2",
  "description": "Multi-viewer screen sharing with cascade relay (蜈蚣法) - Electron Edition",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-electron-dev.ps1 .",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/start-electron-dev.ps1 .",
    "dev:single:native": "powershell -ExecutionPolicy Bypass -File scripts/start-single-test-env.ps1 -EnableNativePeerTransport",
    "dev:dual": "powershell -ExecutionPolicy Bypass -File scripts/start-dual-test-env.ps1",
    "dev:dual:native": "powershell -ExecutionPolicy Bypass -File scripts/start-dual-test-env.ps1 -EnableNativePeerTransport",
    "dual:web": "powershell -ExecutionPolicy Bypass -File scripts/start-dual-web-test-env.ps1 -EnableNativePeerTransport",
    "triple:nwn": "powershell -ExecutionPolicy Bypass -File scripts/start-triple-nwn-test-env.ps1 -EnableNativePeerTransport",
    "dev:dual:web": "powershell -ExecutionPolicy Bypass -File scripts/start-dual-web-test-env.ps1 -EnableNativePeerTransport",
    "dev:triple": "powershell -ExecutionPolicy Bypass -File scripts/start-triple-test-env.ps1",
    "dev:triple:native": "powershell -ExecutionPolicy Bypass -File scripts/start-triple-test-env.ps1 -EnableNativePeerTransport",
    "server": "node server/index.js",
    "build:vds-web": "vite build --config vds_web/vite.config.ts",
    "check:vds-web": "tsc -p vds_web/tsconfig.json --noEmit",
    "check:web-mobile-diagnostics": "node scripts/check-web-mobile-diagnostics.js --self-test",
    "check:web-mobile-code": "npm run check:vds-web && npm run test:vds-web && npm run check:web-mobile-diagnostics && npm run test:server",
    "test:vds-web": "node scripts/test-vds-web-protocol.js && node scripts/test-vds-web-frame-validation.js && node scripts/test-vds-web-player-lifecycle.js && node --test tests/web/*.test.js",
    "verify:playback": "npm run build:vds-web && node scripts/test-vds-web-playback.js && node scripts/test-local-playback-e2e.js",
    "verify:nat": "node scripts/test-native-nat.js",
    "build": "electron-builder",
    "build:media-agent": "powershell -ExecutionPolicy Bypass -File scripts/build-media-agent.ps1 -Configuration Release",
    "smoke:media-agent": "powershell -ExecutionPolicy Bypass -File scripts/smoke-media-agent.ps1",
    "test:media-agent": "powershell -ExecutionPolicy Bypass -File scripts/test-media-agent.ps1 -Configuration Release",
    "test:server": "node scripts/test-server-core.js",
    "test:server-revival": "node scripts/test-server-revival.js",
    "test:server-reconnect": "node scripts/test-server-reconnect.js",
    "test:desktop": "node --test tests/desktop/*.test.js",
    "test": "npm run check",
    "check": "npm run check:architecture && npm run check:logging && npm run check:web-mobile-code && npm run test:server-revival && npm run test:server-reconnect && npm run test:desktop",
    "check:dependencies": "npm audit --omit=dev && npm --prefix server audit --omit=dev",
    "verify:media-agent": "powershell -ExecutionPolicy Bypass -File scripts/verify-media-agent.ps1 -Configuration Release",
    "check:architecture": "npm run check:renderer-entry && npm run check:renderer-syntax && npm run check:renderer-bridge && npm run check:room-client-dispatcher && npm run check:media-agent-boundary",
    "check:media-agent-boundary": "node scripts/check-media-agent-boundary.js",
    "check:renderer-entry": "node scripts/check-renderer-entry.js",
    "check:renderer-syntax": "node scripts/check-renderer-syntax.js",
    "check:renderer-bridge": "node scripts/check-renderer-bridge.js",
    "check:room-client-dispatcher": "node scripts/check-room-client-dispatcher.js",
    "check:logging": "powershell -ExecutionPolicy Bypass -File scripts/check-logging-policy.ps1",
    "check:server-docker": "node scripts/check-server-docker-context.js",
    "e2e:media-agent": "powershell -ExecutionPolicy Bypass -File scripts/manual-media-agent-e2e.ps1",
    "rebuild": "electron-rebuild -f",
    "prepare-server-release": "node scripts/prepare-server-release.js",
    "release:github": "node scripts/publish-github-release.js",
    "release:precheck": "node scripts/release-check.js --prebuild",
    "release:check": "node scripts/release-check.js --postbuild",
    "build:release": "npm run release:precheck && npm run build -- --publish never && npm run prepare-server-release && npm run release:check && npm run release:github"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.22.3",
    "koffi": "^2.16.3",
    "process-audio-capture": "^1.0.14",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^42.11.11",
    "electron-builder": "^26.15.3",
    "@electron/rebuild": "^4.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "build": {
    "appId": "com.vds.app",
    "productName": "VDS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "server/public/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime/media-agent",
        "to": "runtime/media-agent",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/app.ico",
      "artifactName": "VDS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://boshan.s.3q.hair/updates/",
      "useMultipleRangeRequest": false
    }
  }
}
