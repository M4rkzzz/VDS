+/* VDS random-NAT exploration: temporary sockets share this agent's credentials,
+ * roles and nomination. A probe never becomes a media path without ICE. */
+typedef struct vds_probe {
+ addr_record_t target;
+ uint8_t transaction[STUN_TRANSACTION_ID_SIZE];
+ int socket_index;
+ bool sent;
+} vds_probe_t;
+struct vds_punch_state {
+ timestamp_t deadline, next_send;
+ unsigned cursor, round, count;
+ uint16_t lookup[4096];
+ vds_probe_t probes[VDS_NAT_PUNCH_SOCKETS * VDS_NAT_PUNCH_TARGETS];
+};
+static unsigned vds_probe_hash(const uint8_t *transaction) {
+ uint32_t hash = 2166136261u;
+ for (unsigned i = 0; i < STUN_TRANSACTION_ID_SIZE; ++i) hash = (hash ^ transaction[i]) * 16777619u;
+ return hash & 4095u;
+}
+static void vds_punch_finish(juice_agent_t *agent) {
+ int keep = agent->state != JUICE_STATE_FAILED && agent->selected_pair ? agent->selected_pair->vds_socket : 0;
+ if (agent->vds_punch) JLOG_INFO("VDS random punch finished, selected_socket=%d", keep);
+ for (int i = 0; i < agent->entries_count; ++i) {
+  agent_stun_entry_t *entry = agent->entries + i;
+  if (entry->vds_socket && entry->vds_socket != keep) {
+   entry->state = AGENT_STUN_ENTRY_STATE_CANCELLED;
+   if (entry->pair) entry->pair->state = ICE_CANDIDATE_PAIR_STATE_FROZEN;
+  }
+ }
+ conn_close_punch_sockets(agent, keep);
+ free(agent->vds_punch); agent->vds_punch = NULL;
+ agent->vds_punch_done = true;
+}
+void vds_punch_update(juice_agent_t *agent, timestamp_t *next_timestamp) {
+ if (!agent->config.enable_multi_socket_punch || agent->vds_punch_done || !agent->conn_impl) return;
+ timestamp_t now = current_timestamp();
+ if (agent->state == JUICE_STATE_FAILED || agent->state == JUICE_STATE_COMPLETED ||
+     (agent->selected_pair && agent->selected_pair->nominated)) {
+  vds_punch_finish(agent); return;
+ }
+ if (!agent->vds_punch) {
+  // A failed local STUN route says nothing about whether another local
+  // interface can check the peer's advertised endpoint. No local mapping is
+  // needed for the peer to authenticate that check and discover our address.
+  if (!agent->vds_prediction_emitted ||
+      !*agent->remote.ice_ufrag || !*agent->remote.ice_pwd || agent->mode == AGENT_MODE_UNKNOWN) return;
+  ice_candidate_t *groups[ICE_MAX_CANDIDATES_COUNT];
+  unsigned group_count = 0;
+  ice_candidate_t *anchor = NULL;
+  const vds_nat_mapping_behavior local_mode = vds_classify_mapping(agent);
+  const bool local_unknown = local_mode == VDS_NAT_MAPPING_UNKNOWN;
+  for (int i = 0; i < agent->remote.candidates_count; ++i) {
+   ice_candidate_t *candidate = agent->remote.candidates + i;
+   const bool enhanced = candidate->vds_punch &&
+    !strcmp(candidate->vds_ufrag, agent->remote.ice_ufrag) &&
+    candidate->vds_nat_mode >= 0 && candidate->vds_nat_mode <= 2;
+   /* Standard ICE peers need not implement our metadata to authenticate a
+    * Binding check from another local socket. Without their NAT evidence,
+    * probe only advertised endpoints; never guess their allocation range.
+    * An omitted candidate ufrag inherits the current remote SDP credentials. */
+   const bool standard = !candidate->vds_punch &&
+    (!*candidate->vds_ufrag || !strcmp(candidate->vds_ufrag, agent->remote.ice_ufrag)) &&
+    local_mode != VDS_NAT_MAPPING_ENDPOINT_INDEPENDENT;
+   if (candidate->type == ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE && !candidate->vds_predicted &&
+       candidate->transport == ICE_CANDIDATE_TRANSPORT_UDP && candidate->resolved.addr.ss_family == AF_INET &&
+       ((enhanced && (local_unknown || candidate->vds_nat_mode == VDS_NAT_MAPPING_UNKNOWN)) || standard)) {
+    unsigned group = 0;
