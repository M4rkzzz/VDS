+static void conn_poll_tcp_accept(juice_agent_t *agent, socket_t listener) {
+ conn_impl_t *impl = agent->conn_impl;
+ for (unsigned batch = 0; batch < 16; ++batch) {
+  addr_record_t remote; memset(&remote, 0, sizeof(remote)); remote.len = sizeof(remote.addr); remote.socktype = SOCK_STREAM;
+  socket_t sock = accept(listener, (struct sockaddr *)&remote.addr, &remote.len);
+  if (sock == INVALID_SOCKET) break;
