+// RFC 8489 TCP STUN uses its own 20-byte header and message length, without
+// the RFC 4571 prefix used by the peer ICE-TCP stream.
+int tcp_stun_write(socket_t sock, const char *data, size_t size, tcp_ice_write_context_t *context) {
+#if defined(__APPLE__) || defined(_WIN32)
+ int flags = 0;
+#else
+ int flags = MSG_NOSIGNAL;
+#endif
+ if (data) {
+  if (context->pending) return -SEAGAIN;
+  if (size > sizeof(context->buffer)) return -SEMSGSIZE;
+  memcpy(context->buffer, data, size); context->length = (uint16_t)size;
+  context->bytes_written = 0; context->pending = true;
+ }
+ while (context->pending && context->bytes_written < context->length) {
+  int sent = send(sock, context->buffer + context->bytes_written, context->length - context->bytes_written, flags);
+  if (sent < 0) return -sockerrno;
+  if (!sent) return -SECONNRESET;
+  context->bytes_written += sent;
+ }
+ context->pending = false;
+ return context->length;
+}
+
+int tcp_stun_read(socket_t sock, tcp_ice_read_context_t *context) {
+ if (!context->pending) { context->pending = true; context->bytes_read = 0; context->length = 20; }
+ while (context->bytes_read < context->length) {
+  int size = recv(sock, context->buffer + context->bytes_read, context->length - context->bytes_read, 0);
+  if (size < 0) return -sockerrno;
+  if (!size) return 0;
+  context->bytes_read += size;
+  if (context->bytes_read == 20) {
+   const unsigned char *header = (const unsigned char *)context->buffer;
+   unsigned length = ((unsigned)header[2] << 8) | header[3];
+   if ((header[0] & 0xc0) || (length & 3) || header[4] != 0x21 || header[5] != 0x12 || header[6] != 0xa4 || header[7] != 0x42)
+    return -SECONNRESET;
+   if (length + 20 > sizeof(context->buffer)) return -SEMSGSIZE;
+   context->length = (uint16_t)(length + 20);
+  }
+ }
+ context->pending = false;
+ return context->length;
+}
