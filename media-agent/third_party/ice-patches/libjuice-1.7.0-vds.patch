+  struct vds_punch_state *state = calloc(1, sizeof(*state));
+  if (!state) { agent->vds_punch_done = true; return; }
+  uint16_t ports[VDS_NAT_PUNCH_TARGETS]; uint32_t seed;
+  juice_random(&seed, sizeof(seed));
+  uint16_t port = addr_get_port((const struct sockaddr *)&anchor->resolved.addr);
+  size_t count = 0;
+  /* Stable peers need only their confirmed endpoint. For a linear peer,
+   * preserve signaled prediction order before adding genuine endpoints. */
+  for (int pass = 0; pass < 2; ++pass) {
+   for (int i = 0; i < agent->remote.candidates_count && count < VDS_NAT_PUNCH_TARGETS; ++i) {
+    const ice_candidate_t *candidate = agent->remote.candidates + i;
+    if (candidate->type != ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE ||
+        candidate->resolved.addr.ss_family != AF_INET ||
+        ((enhanced_remote || *candidate->vds_ufrag) &&
+         strcmp(candidate->vds_ufrag, agent->remote.ice_ufrag)) ||
+        !addr_record_is_equal(&candidate->resolved, &anchor->resolved, false) ||
+        candidate->vds_predicted != (pass == 0) ||
+        (candidate->vds_predicted && (!enhanced_remote || anchor->vds_nat_mode != VDS_NAT_MAPPING_SEQUENTIAL))) continue;
+    uint16_t observed = addr_get_port((const struct sockaddr *)&candidate->resolved.addr);
+    size_t j; for (j = 0; j < count && ports[j] != observed; ++j) {}
+    if (j == count && observed) ports[count++] = observed;
+   }
+  }
+  const size_t confirmed_count = count;
+  if (enhanced_remote && anchor->vds_nat_mode == VDS_NAT_MAPPING_UNKNOWN) {
+   uint16_t random_ports[VDS_NAT_PUNCH_TARGETS];
+   bool local_concentrated = local_mode == VDS_NAT_MAPPING_UNKNOWN &&
+    vds_nat_observations_concentrated(agent->vds_observations, agent->vds_observation_count);
+   size_t random_count = vds_nat_random_ports_joint_round(port, ports, confirmed_count, seed,
+    agent->vds_punch_plan / group_count, local_concentrated, random_ports, VDS_NAT_PUNCH_TARGETS);
+   for (size_t i = 0; i < random_count && count < VDS_NAT_PUNCH_TARGETS; ++i) {
+    size_t j; for (j = 0; j < count && ports[j] != random_ports[i]; ++j) {}
+    if (j == count) ports[count++] = random_ports[i];
+   }
+   /* Ordinary ICE already checks confirmed STUN endpoints. For unknown
+    * mappings, give new hypotheses the first auxiliary allocations instead
+    * of spending sixteen mappings on each old STUN-only endpoint. */
+   /* One genuine endpoint can still be stable despite incomplete evidence.
+    * Keep it first so its existing second transmission is not delayed behind
+    * the entire hypothesis list after transient loss. */
+   if (count > confirmed_count && confirmed_count > 1) {
+    uint16_t confirmed[VDS_NAT_PUNCH_TARGETS];
+    memcpy(confirmed, ports, confirmed_count * sizeof(*ports));
+    memmove(ports, ports + confirmed_count, (count - confirmed_count) * sizeof(*ports));
+    memcpy(ports + count - confirmed_count, confirmed, confirmed_count * sizeof(*ports));
+   }
+  }
+  const addr_record_t *targets[VDS_NAT_PUNCH_TARGETS];
+  if (enhanced_remote) {
+   for (size_t i = 0; i < count; ++i) {
+    targets[i] = &anchor->resolved;
+   }
+  } else {
