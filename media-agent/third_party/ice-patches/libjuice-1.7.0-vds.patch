+int conn_poll_open_punch_sockets(juice_agent_t *agent, unsigned count) {
+ conn_impl_t *impl = agent->conn_impl;
+ udp_socket_config_t config = {agent->config.bind_address, agent->config.local_port_range_begin, agent->config.local_port_range_end};
