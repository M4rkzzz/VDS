+/**
+ * Copyright (c) 2026 VDS contributors
+ * SPDX-License-Identifier: MPL-2.0
+ */
+#ifndef JUICE_VDS_STUN_RESOLVER_H
+#define JUICE_VDS_STUN_RESOLVER_H
+
+#include "addr.h"
+#include <string.h>
+
+static inline bool vds_stun_same_endpoint(const struct addrinfo *a, const struct addrinfo *b) {
+    if (a->ai_family != b->ai_family) return false;
+    if (a->ai_family == AF_INET) {
+        const struct sockaddr_in *x = (const struct sockaddr_in *)a->ai_addr;
+        const struct sockaddr_in *y = (const struct sockaddr_in *)b->ai_addr;
+        return x->sin_port == y->sin_port && x->sin_addr.s_addr == y->sin_addr.s_addr;
+    }
+    const struct sockaddr_in6 *x = (const struct sockaddr_in6 *)a->ai_addr;
+    const struct sockaddr_in6 *y = (const struct sockaddr_in6 *)b->ai_addr;
+    return x->sin6_port == y->sin6_port && x->sin6_scope_id == y->sin6_scope_id &&
+           memcmp(&x->sin6_addr, &y->sin6_addr, sizeof(x->sin6_addr)) == 0;
+}
+
+// Keep the resolver's preferred endpoint, then prefer the other address family.
+// If only one family exists, keep its first two distinct endpoints. Scan the
+// complete DNS answer without increasing the existing two-probe budget.
+static inline int vds_stun_select(const struct addrinfo *list, addr_record_t records[2]) {
+    const struct addrinfo *selected[2] = {NULL, NULL};
+    int count = 0;
+    for (const struct addrinfo *ai = list; ai; ai = ai->ai_next) {
+        size_t expected = ai->ai_family == AF_INET ? sizeof(struct sockaddr_in) :
+                          ai->ai_family == AF_INET6 ? sizeof(struct sockaddr_in6) : 0;
+        if (!expected || !ai->ai_addr || ai->ai_addrlen < expected ||
+            ai->ai_addr->sa_family != ai->ai_family) continue;
+        if (!count) {
+            selected[count++] = ai;
+        } else if (!vds_stun_same_endpoint(selected[0], ai)) {
+            if (count == 1) selected[count++] = ai;
+            else if (ai->ai_family != selected[0]->ai_family) selected[1] = ai;
+            if (selected[1]->ai_family != selected[0]->ai_family) break;
+        }
+    }
+    for (int i = 0; i < count; ++i) {
+        memset(records + i, 0, sizeof(*records));
+        records[i].len = selected[i]->ai_family == AF_INET ? sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6);
+        memcpy(&records[i].addr, selected[i]->ai_addr, records[i].len);
+        records[i].socktype = SOCK_DGRAM;
+    }
+    return count;
+}
+
+static inline int vds_stun_resolve(const char *host, const char *service, addr_record_t records[2]) {
+    struct addrinfo hints;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_DGRAM;
+    hints.ai_protocol = IPPROTO_UDP;
+#ifdef AI_ADDRCONFIG
+    hints.ai_flags = AI_ADDRCONFIG;
+#endif
+    struct addrinfo *list = NULL;
+    if (getaddrinfo(host, service, &hints, &list)) return -1;
+    int count = vds_stun_select(list, records);
+    freeaddrinfo(list);
+    return count;
+}
+#endif
