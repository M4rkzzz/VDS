+static void conn_poll_tcp_reserve(conn_impl_t *impl, const udp_socket_config_t *config) {
+ struct addrinfo hints; memset(&hints, 0, sizeof(hints));
+ hints.ai_family = AF_UNSPEC; hints.ai_socktype = SOCK_STREAM;
+ hints.ai_protocol = IPPROTO_TCP; hints.ai_flags = AI_PASSIVE | AI_NUMERICSERV;
+ struct addrinfo *list = NULL;
+ if (getaddrinfo(config->bind_address, "0", &hints, &list)) return;
+ for (const struct addrinfo *ai = list; ai; ai = ai->ai_next) {
+  if (ai->ai_family != AF_INET && ai->ai_family != AF_INET6) continue;
+  int family = ai->ai_family == AF_INET6 ? 1 : 0;
+  if (impl->tcp_so_reservations[family] != INVALID_SOCKET) continue;
+  addr_record_t base; memset(&base, 0, sizeof(base));
+  base.len = (socklen_t)ai->ai_addrlen; base.socktype = SOCK_STREAM;
+  memcpy(&base.addr, ai->ai_addr, base.len);
+  const unsigned begin = config->port_begin, end = config->port_end;
+  for (unsigned port = begin; port <= end; ++port) {
+   // SO and passive addresses must be distinguishable in the candidate table.
+   if (port && port == impl->tcp_port) continue;
+   addr_set_port((struct sockaddr *)&base.addr, (uint16_t)port);
+   socket_t sock = tcp_bind_socket(&base);
+   if (sock == INVALID_SOCKET) continue;
+   base.len = sizeof(base.addr);
+   if (getsockname(sock, (struct sockaddr *)&base.addr, &base.len)) { closesocket(sock); continue; }
+   if (listen(sock, SOMAXCONN)) { closesocket(sock); continue; }
+   impl->tcp_so_reservations[family] = sock; impl->tcp_so_bases[family] = base;
+   break;
+  }
+ }
