+/* VDS random-NAT exploration: temporary sockets share this agent's credentials,
+ * roles and nomination. A probe never becomes a media path without ICE. */
+typedef struct vds_probe {
+ addr_record_t target;
+ uint8_t transaction[STUN_TRANSACTION_ID_SIZE];
+ int socket_index;
+ bool sent;
+} vds_probe_t;
+struct vds_punch_state {
+ timestamp_t deadline, next_send;
+ unsigned cursor, round, count;
+ uint16_t lookup[4096];
+ vds_probe_t probes[VDS_NAT_PUNCH_SOCKETS * VDS_NAT_PUNCH_TARGETS];
+};
+static unsigned vds_probe_hash(const uint8_t *transaction) {
+ uint32_t hash = 2166136261u;
+ for (unsigned i = 0; i < STUN_TRANSACTION_ID_SIZE; ++i) hash = (hash ^ transaction[i]) * 16777619u;
+ return hash & 4095u;
+}
+static void vds_punch_finish(juice_agent_t *agent) {
+ int keep = agent->state != JUICE_STATE_FAILED && agent->selected_pair ? agent->selected_pair->vds_socket : 0;
+ if (agent->vds_punch) JLOG_INFO("VDS random punch finished, selected_socket=%d", keep);
+ for (int i = 0; i < agent->entries_count; ++i) {
+  agent_stun_entry_t *entry = agent->entries + i;
+  if (entry->vds_socket && entry->vds_socket != keep) {
+   entry->state = AGENT_STUN_ENTRY_STATE_CANCELLED;
+   if (entry->pair) entry->pair->state = ICE_CANDIDATE_PAIR_STATE_FROZEN;
+  }
+ }
+ conn_close_punch_sockets(agent, keep);
+ free(agent->vds_punch); agent->vds_punch = NULL;
+ agent->vds_punch_done = true;
+}
+void vds_punch_update(juice_agent_t *agent, timestamp_t *next_timestamp) {
+ if (!agent->config.enable_multi_socket_punch || agent->vds_punch_done || !agent->conn_impl) return;
+ timestamp_t now = current_timestamp();
+ if (agent->state == JUICE_STATE_FAILED || agent->state == JUICE_STATE_COMPLETED ||
+     (agent->selected_pair && agent->selected_pair->nominated)) {
+  vds_punch_finish(agent); return;
+ }
+ if (!agent->vds_punch) {
+  if (!agent->vds_prediction_emitted || agent->vds_observation_count < 3 ||
+      !*agent->remote.ice_ufrag || !*agent->remote.ice_pwd || agent->mode == AGENT_MODE_UNKNOWN) return;
+  ice_candidate_t *anchor = NULL;
+  const vds_nat_mapping_behavior local_mode = vds_nat_classify_ports(agent->vds_observations, agent->vds_observation_count, NULL);
+  const bool local_unknown = local_mode == VDS_NAT_MAPPING_UNKNOWN;
+  for (int i = 0; i < agent->remote.candidates_count; ++i) {
+   ice_candidate_t *candidate = agent->remote.candidates + i;
+   if (candidate->type == ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE && !candidate->vds_predicted &&
+       candidate->transport == ICE_CANDIDATE_TRANSPORT_UDP && candidate->resolved.addr.ss_family == AF_INET &&
+       candidate->vds_punch && !strcmp(candidate->vds_ufrag, agent->remote.ice_ufrag) &&
+       candidate->vds_nat_mode >= 0 && candidate->vds_nat_mode <= 2 &&
+       (local_unknown || candidate->vds_nat_mode == VDS_NAT_MAPPING_UNKNOWN)) { anchor = candidate; break; }
+  }
+  if (!anchor) return;
+  if (!agent->vds_punch_start) agent->vds_punch_start = now + 500;
+  if (now < agent->vds_punch_start) {
+   if (*next_timestamp > agent->vds_punch_start) *next_timestamp = agent->vds_punch_start;
+   return;
+  }
+  if (agent->selected_pair) return; // ordinary ICE already has a usable path
+  struct vds_punch_state *state = calloc(1, sizeof(*state));
+  if (!state) { agent->vds_punch_done = true; return; }
+  uint16_t ports[VDS_NAT_PUNCH_TARGETS]; uint32_t seed;
+  juice_random(&seed, sizeof(seed));
+  uint16_t port = addr_get_port((const struct sockaddr *)&anchor->resolved.addr);
+  size_t count = 0;
+  /* Stable peers need only their confirmed endpoint. For a linear peer,
+   * preserve signaled prediction order before adding genuine endpoints. */
+  for (int pass = 0; pass < 2; ++pass) {
+   for (int i = 0; i < agent->remote.candidates_count && count < VDS_NAT_PUNCH_TARGETS; ++i) {
+    const ice_candidate_t *candidate = agent->remote.candidates + i;
+    if (candidate->type != ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE ||
+        candidate->resolved.addr.ss_family != AF_INET ||
+        !addr_record_is_equal(&candidate->resolved, &anchor->resolved, false) ||
+        candidate->vds_predicted != (pass == 0) ||
+        (candidate->vds_predicted && anchor->vds_nat_mode != VDS_NAT_MAPPING_SEQUENTIAL)) continue;
+    uint16_t observed = addr_get_port((const struct sockaddr *)&candidate->resolved.addr);
+    size_t j; for (j = 0; j < count && ports[j] != observed; ++j) {}
+    if (j == count && observed) ports[count++] = observed;
+   }
+  }
+  if (anchor->vds_nat_mode == VDS_NAT_MAPPING_UNKNOWN) {
+   uint16_t random_ports[VDS_NAT_PUNCH_TARGETS];
+   size_t random_count = vds_nat_random_ports(port, seed, random_ports, VDS_NAT_PUNCH_TARGETS);
+   for (size_t i = 0; i < random_count && count < VDS_NAT_PUNCH_TARGETS; ++i) {
+    size_t j; for (j = 0; j < count && ports[j] != random_ports[i]; ++j) {}
+    if (j == count) ports[count++] = random_ports[i];
+   }
+  }
+  if (!count) { free(state); agent->vds_punch_done = true; return; }
+  unsigned first_socket = local_mode == VDS_NAT_MAPPING_ENDPOINT_INDEPENDENT ? 0 : 1;
+  unsigned last_socket = first_socket ? VDS_NAT_PUNCH_SOCKETS : 0;
+  if (first_socket && !conn_open_punch_sockets(agent)) { free(state); agent->vds_punch_done = true; return; }
+  for (size_t target = 0; target < count; ++target) {
+   for (unsigned socket = first_socket; socket <= last_socket; ++socket) {
+    unsigned index = state->count++;
+    vds_probe_t *probe = state->probes + index;
+    probe->target = anchor->resolved;
+    ((struct sockaddr_in *)&probe->target.addr)->sin_port = htons(ports[target]);
+    probe->socket_index = socket;
+    juice_random(probe->transaction, STUN_TRANSACTION_ID_SIZE);
+    unsigned slot = vds_probe_hash(probe->transaction);
+    while (state->lookup[slot]) slot = (slot + 1) & 4095u;
+    state->lookup[slot] = (uint16_t)(index + 1);
+   }
+  }
+  state->deadline = now + 5000; state->next_send = now;
+  agent->vds_punch = state;
+  JLOG_INFO("VDS random punch started, local_mode=%d remote_mode=%d sockets=%u targets=%u", (int)local_mode, anchor->vds_nat_mode, last_socket - first_socket + 1, (unsigned)count);
+ }
+ struct vds_punch_state *state = agent->vds_punch;
+ if (now >= state->deadline) { vds_punch_finish(agent); return; }
+ if (!agent->selected_pair && now >= state->next_send && state->round < 2) {
+  for (unsigned batch = 0; batch < 32 && state->cursor < state->count; ++batch) {
+   vds_probe_t *probe = state->probes + state->cursor++;
+   agent_stun_entry_t entry; memset(&entry, 0, sizeof(entry));
+   entry.type = AGENT_STUN_ENTRY_TYPE_CHECK; entry.record = probe->target;
+   entry.vds_socket = probe->socket_index;
+   memcpy(entry.transaction_id, probe->transaction, STUN_TRANSACTION_ID_SIZE);
+   if (!agent_send_stun_binding(agent, &entry, STUN_CLASS_REQUEST, 0, NULL, NULL)) probe->sent = true;
+  }
+  state->next_send = now + 20;
+  if (state->cursor == state->count) { state->cursor = 0; ++state->round; state->next_send = now + 250; }
+ }
+ timestamp_t wake = state->round < 2 && !agent->selected_pair ? state->next_send : state->deadline;
+ if (*next_timestamp > wake) *next_timestamp = wake;
+}
+/* Called only after standard STUN short-term integrity verification. */
+void vds_punch_accept(juice_agent_t *agent, const stun_message_t *msg, const addr_record_t *src) {
+ if (src->socktype != SOCK_DGRAM || !*agent->remote.ice_ufrag || msg->msg_method != STUN_METHOD_BINDING) return;
+ const vds_probe_t *probe = NULL;
+ if (msg->msg_class == STUN_CLASS_RESP_SUCCESS && agent->vds_punch) {
+  unsigned slot = vds_probe_hash(msg->transaction_id);
+  while (agent->vds_punch->lookup[slot]) {
+   unsigned index = agent->vds_punch->lookup[slot] - 1;
+   const vds_probe_t *candidate = agent->vds_punch->probes + index;
+   if (!memcmp(candidate->transaction, msg->transaction_id, STUN_TRANSACTION_ID_SIZE)) {
+    if (candidate->sent && candidate->socket_index == agent->vds_rx_socket &&
+        addr_record_is_equal(&candidate->target, src, true)) probe = candidate;
+    break;
+   }
+   slot = (slot + 1) & 4095u;
+  }
+ }
+ if (!probe && msg->msg_class != STUN_CLASS_REQUEST) return;
+ if (!agent->vds_rx_socket && !probe) return;
+ ice_candidate_t *remote = ice_find_candidate_from_addr(&agent->remote, src, ICE_CANDIDATE_TYPE_UNKNOWN);
+ if (!remote) {
+  uint32_t priority = msg->priority ? msg->priority : ice_compute_priority(ICE_CANDIDATE_TYPE_PEER_REFLEXIVE, src->addr.ss_family, 1, 0, false);
+  if (agent_add_remote_reflexive_candidate(agent, ICE_CANDIDATE_TYPE_PEER_REFLEXIVE, priority, src)) return;
+  remote = ice_find_candidate_from_addr(&agent->remote, src, ICE_CANDIDATE_TYPE_UNKNOWN);
+ }
+ if (!remote) return;
+ ice_candidate_pair_t *pair = NULL;
+ for (int i = 0; i < agent->candidate_pairs_count; ++i) {
+  ice_candidate_pair_t *candidate = agent->candidate_pairs + i;
+  if (candidate->vds_socket == agent->vds_rx_socket && candidate->remote == remote) { pair = candidate; break; }
+ }
+ if (!pair) {
+  int index = agent->candidate_pairs_count;
+  if (agent_add_candidate_pair_on(agent, NULL, remote, agent->vds_rx_socket)) return;
+  if (index == agent->candidate_pairs_count) return;
+  pair = agent->candidate_pairs + index;
+ }
+ if (probe && pair->state != ICE_CANDIDATE_PAIR_STATE_SUCCEEDED) {
+  for (int i = 0; i < agent->entries_count; ++i) {
+   agent_stun_entry_t *entry = agent->entries + i;
+   if (entry->pair == pair) {
+    memcpy(entry->transaction_id, probe->transaction, STUN_TRANSACTION_ID_SIZE);
+    entry->mode = agent->mode; entry->state = AGENT_STUN_ENTRY_STATE_PENDING;
+    break;
+   }
+  }
+ }
+}
