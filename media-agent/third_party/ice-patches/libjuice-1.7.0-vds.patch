+  if (state->cursor == state->count) { state->cursor = 0; ++state->round; }
+ }
+ timestamp_t wake = state->round < 2 && !agent->selected_pair ? state->next_send : state->deadline;
+ if (*next_timestamp > wake) *next_timestamp = wake;
+}
+/* Called only after standard STUN short-term integrity verification. */
+void vds_punch_accept(juice_agent_t *agent, const stun_message_t *msg, const addr_record_t *src) {
+ if (src->socktype != SOCK_DGRAM || !*agent->remote.ice_ufrag || msg->msg_method != STUN_METHOD_BINDING) return;
+ const vds_probe_t *probe = NULL;
+ if (msg->msg_class == STUN_CLASS_RESP_SUCCESS && agent->vds_punch) {
+  unsigned slot = vds_probe_hash(msg->transaction_id);
+  while (agent->vds_punch->lookup[slot]) {
+   unsigned index = agent->vds_punch->lookup[slot] - 1;
+   const vds_probe_t *candidate = agent->vds_punch->probes + index;
+   if (!memcmp(candidate->transaction, msg->transaction_id, STUN_TRANSACTION_ID_SIZE)) {
+    if (candidate->sent && candidate->socket_index == agent->vds_rx_socket &&
+        addr_record_is_equal(&candidate->target, src, true)) probe = candidate;
+    break;
+   }
+   slot = (slot + 1) & 4095u;
+  }
+ }
+ if (!probe && msg->msg_class != STUN_CLASS_REQUEST) return;
+ if (!agent->vds_rx_socket && !probe) return;
+ ice_candidate_t *remote = ice_find_candidate_from_addr(&agent->remote, src, ICE_CANDIDATE_TYPE_UNKNOWN);
+ if (!remote) {
+  uint32_t priority = msg->priority ? msg->priority : ice_compute_priority(ICE_CANDIDATE_TYPE_PEER_REFLEXIVE, src->addr.ss_family, 1, 0, false);
+  if (agent_add_remote_reflexive_candidate(agent, ICE_CANDIDATE_TYPE_PEER_REFLEXIVE, priority, src)) return;
+  remote = ice_find_candidate_from_addr(&agent->remote, src, ICE_CANDIDATE_TYPE_UNKNOWN);
+ }
+ if (!remote) return;
+ ice_candidate_pair_t *pair = NULL;
+ for (int i = 0; i < agent->candidate_pairs_count; ++i) {
+  ice_candidate_pair_t *candidate = agent->candidate_pairs + i;
+  if (candidate->vds_socket == agent->vds_rx_socket && candidate->remote == remote) { pair = candidate; break; }
+ }
+ if (!pair) {
+  int index = agent->candidate_pairs_count;
+  if (agent_add_candidate_pair_on(agent, NULL, remote, agent->vds_rx_socket)) return;
+  if (index == agent->candidate_pairs_count) return;
+  pair = agent->candidate_pairs + index;
+ }
+ if (probe && pair->state != ICE_CANDIDATE_PAIR_STATE_SUCCEEDED) {
+  for (int i = 0; i < agent->entries_count; ++i) {
+   agent_stun_entry_t *entry = agent->entries + i;
+   if (entry->pair == pair) {
+    memcpy(entry->transaction_id, probe->transaction, STUN_TRANSACTION_ID_SIZE);
+    entry->mode = agent->mode; entry->state = AGENT_STUN_ENTRY_STATE_PENDING;
+    break;
+   }
+  }
+ }
