+    * Waiting a full plan per public address lets dead high-priority exits
+    * starve a usable lower-priority one. Explore the known endpoints together
+    * within the existing target/socket budget, without guessing any ports.
+    * Enhanced peers retain their per-exit classification and prediction plan. */
+   count = 0;
+   for (unsigned group = 0; group < group_count; ++group) {
+    if (groups[group]->vds_punch) continue;
+    for (int i = 0; i < agent->remote.candidates_count && count < VDS_NAT_PUNCH_TARGETS; ++i) {
+     const ice_candidate_t *candidate = agent->remote.candidates + i;
+     if (candidate->type != ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE || candidate->vds_predicted ||
+         candidate->vds_punch || candidate->transport != ICE_CANDIDATE_TRANSPORT_UDP ||
+         candidate->resolved.addr.ss_family != AF_INET ||
+         (*candidate->vds_ufrag && strcmp(candidate->vds_ufrag, agent->remote.ice_ufrag)) ||
+         !addr_record_is_equal(&candidate->resolved, &groups[group]->resolved, false)) continue;
+     size_t j;
+     for (j = 0; j < count && !addr_record_is_equal(targets[j], &candidate->resolved, true); ++j) {}
+     if (j == count) {
+      targets[count] = &candidate->resolved;
+      ports[count++] = addr_get_port((const struct sockaddr *)&candidate->resolved.addr);
+     }
+    }
+   }
+  }
+  if (!count) { free(state); agent->vds_punch_done = true; return; }
+  unsigned first_socket = local_mode == VDS_NAT_MAPPING_ENDPOINT_INDEPENDENT ? 0 : 1;
+  const unsigned requested_sockets = enhanced_remote
+   ? vds_nat_punch_socket_count(local_mode, anchor->vds_nat_mode, agent->vds_punch_plan / group_count)
+   : VDS_NAT_PUNCH_SOCKETS;
+  unsigned last_socket = first_socket + requested_sockets - 1;
+  /* A narrow local port range or partial bind failure must not disable
+   * destination exploration. Use only the contiguous sockets actually open. */
+  if (last_socket) last_socket = (unsigned)conn_open_punch_sockets(agent, last_socket);
+  if (!last_socket) first_socket = 0;
+  const unsigned socket_count = last_socket - first_socket + 1;
+  bool primary_targets[VDS_NAT_PUNCH_TARGETS] = {false};
+  /* A sole confirmed endpoint may be stable despite insufficient server-IP
+   * evidence. Probe it on the auxiliary source in the first plan as well;
+   * ordinary ICE already covers the primary, which may be the failed path. */
+  if (enhanced_remote && confirmed_count > 1 && local_mode == VDS_NAT_MAPPING_UNKNOWN && anchor->vds_nat_mode == VDS_NAT_MAPPING_UNKNOWN) {
+   /* Ordinary ICE owns these endpoints on socket zero. Reuse that source for
+    * one wave instead of consuming an extra NAT mapping for the same target.
+    * New random hypotheses still use the auxiliary source selected above. */
+   for (int i = 0; i < agent->entries_count; ++i) {
+    const agent_stun_entry_t *entry = agent->entries + i;
+    if (entry->type != AGENT_STUN_ENTRY_TYPE_CHECK || entry->vds_socket ||
+        entry->record.socktype != SOCK_DGRAM || entry->record.addr.ss_family != AF_INET) continue;
+    const struct sockaddr_in *known = (const struct sockaddr_in *)&entry->record.addr;
+    const struct sockaddr_in *exit = (const struct sockaddr_in *)&anchor->resolved.addr;
+    if (known->sin_addr.s_addr != exit->sin_addr.s_addr) continue;
