+
+// Runs under the existing connection lock; never creates another socket/thread.
+static bool vds_is_public_destination(const addr_record_t *record) {
+	if (record->addr.ss_family != AF_INET) return false;
+	uint32_t ip = ntohl(((const struct sockaddr_in *)&record->addr)->sin_addr.s_addr);
+	return vds_nat_is_public_ipv4_destination(ip);
+
+}
+
+static bool vds_server_requests_pending(const juice_agent_t *agent) {
+	for (int i = 0; i < agent->entries_count; ++i)
+		if (agent->entries[i].type == AGENT_STUN_ENTRY_TYPE_SERVER &&
+		    agent->entries[i].state == AGENT_STUN_ENTRY_STATE_PENDING) return true;
+	return false;
+}
+
+static void vds_flush_reflexive_candidates(juice_agent_t *agent) {
+	for (int i = 0; i < agent->local.candidates_count; ++i) {
+		ice_candidate_t *candidate = agent->local.candidates + i;
+		if (candidate->type != ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE || candidate->vds_emitted) continue;
+		char buffer[BUFFER_SIZE];
+		int length = ice_generate_candidate_sdp(candidate, buffer, sizeof(buffer));
+		if (length < 0) continue;
+		int extra = snprintf(buffer + length, sizeof(buffer) - length, " vds-probe-count %u",
+		                     (unsigned int)agent->vds_observation_count);
+		if (extra < 0 || (size_t)extra >= sizeof(buffer) - length) continue;
+		candidate->vds_emitted = true;
+		if (agent->config.cb_candidate)
+			agent->config.cb_candidate(agent, buffer, agent->config.user_ptr);
+	}
+}
+
+static bool vds_confirmed_sequential_remote(const juice_agent_t *agent, const ice_candidate_t *remote) {
+	if (!remote->vds_predicted || remote->transport != ICE_CANDIDATE_TRANSPORT_UDP ||
+	    remote->resolved.addr.ss_family != AF_INET || !remote->vds_nat_step ||
+	    remote->vds_nat_step < -16 || remote->vds_nat_step > 16 ||
+	    !*remote->vds_ufrag || strcmp(remote->vds_ufrag, agent->remote.ice_ufrag)) return false;
+	for (int i = 0; i < agent->remote.candidates_count; ++i) {
+		const ice_candidate_t *candidate = agent->remote.candidates + i;
+		if (!candidate->vds_predicted && candidate->type == ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE &&
+		    candidate->resolved.addr.ss_family == AF_INET &&
+		    addr_record_is_equal(&candidate->resolved, &remote->resolved, false)) return true;
+	}
+	return false;
+}
+
+static void vds_emit_predictions(juice_agent_t *agent, bool deadline) {
+	if (!agent->config.enable_port_prediction || agent->vds_prediction_emitted) return;
+	if (!deadline && vds_server_requests_pending(agent)) return;
+	// Address confirmation is delivered first. Checks wait in a bounded single grace window.
+	vds_flush_reflexive_candidates(agent);
+	if (agent->selected_pair || !agent->vds_observation_count) {
+		agent->vds_prediction_emitted = true;
+		return;
+	}
+	uint16_t ports[VDS_NAT_MAX_PREDICTED_PORTS];
+	int step = 0;
+	size_t count = vds_nat_predict_ports(agent->vds_observations, agent->vds_observation_count,
+	                                   ports, VDS_NAT_MAX_PREDICTED_PORTS, &step);
+	if (!count)
+		count = vds_nat_neighbor_ports(agent->vds_observations, agent->vds_observation_count,
+		                               ports, VDS_NAT_MAX_PREDICTED_PORTS);
+	agent->vds_prediction_emitted = true;
+	if (!count) return;
+	uint32_t address = 0;
+	uint32_t last_sequence = 0;
+	for (size_t i = 0; i < agent->vds_observation_count; ++i) {
+		const vds_nat_port_observation *observation = agent->vds_observations + i;
+		if (observation->valid && observation->sequence > last_sequence) {
+			address = observation->address;
+			last_sequence = observation->sequence;
+		}
+	}
+	for (size_t i = 0; i < count; ++i) {
+		// Leave ample capacity for subsequently discovered genuine/prflx candidates.
+		if (agent->local.candidates_count >= ICE_MAX_CANDIDATES_COUNT - 32) break;
+		addr_record_t record;
+		memset(&record, 0, sizeof(record));
+		struct sockaddr_in *sa = (struct sockaddr_in *)&record.addr;
+		sa->sin_family = AF_INET;
+		sa->sin_addr.s_addr = address;
+		sa->sin_port = htons(ports[i]);
+		record.len = sizeof(*sa);
+		record.socktype = SOCK_DGRAM;
+		if (ice_find_candidate_from_addr(&agent->local, &record, ICE_CANDIDATE_TYPE_UNKNOWN)) continue;
+		ice_candidate_t candidate;
+		if (ice_create_local_candidate(ICE_CANDIDATE_TYPE_SERVER_REFLEXIVE, 1,
+		                               agent->local.candidates_count, &record, &candidate,
+		                               ICE_CANDIDATE_TRANSPORT_UDP)) continue;
+		candidate.vds_predicted = true;
+		candidate.vds_emitted = true;
+		candidate.vds_nat_step = step;
+		candidate.vds_probe_index = last_sequence;
+		strcpy(candidate.vds_ufrag, agent->local.ice_ufrag);
+		// Real srflx is type preference 100; hypotheses are always lower priority.
+		candidate.priority = (80U << 24) | ((uint32_t)(65535 - i) << 8) | 255;
+		if (ice_add_candidate(&candidate, &agent->local)) continue;
+		char buffer[BUFFER_SIZE];
+		if (ice_generate_candidate_sdp(&candidate, buffer, sizeof(buffer)) < 0) continue;
+		if (agent->config.cb_candidate)
+			agent->config.cb_candidate(agent, buffer, agent->config.user_ptr);
+	}
+}
