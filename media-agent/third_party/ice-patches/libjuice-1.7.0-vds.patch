+  if (ioctlsocket(sock, FIONBIO, &nbio)) { closesocket(sock); continue; }
+  tcp_set_no_delay(sock);
+  addr_unmap_inet6_v4mapped((struct sockaddr *)&remote.addr, &remote.len);
+  // Only unauthenticated handshakes consume this provisional budget. Reclaim
+  // the oldest provisional socket so an idle stranger cannot claim all slots.
+  unsigned pending = 0; tcp_connection_t *oldest = NULL;
+  for (tcp_connection_t *tcp = impl->tcp_connections; tcp; tcp = tcp->next)
+   if (tcp->incoming && !tcp->authenticated && tcp->sock != INVALID_SOCKET) {
+    ++pending; if (!oldest || tcp->auth_deadline < oldest->auth_deadline) oldest = tcp;
+   }
+  if (pending >= MAX_PEER_REFLEXIVE_CANDIDATES_COUNT && oldest) conn_poll_change_tcp_fail(agent, oldest);
+  tcp_connection_t *tcp = calloc(1, sizeof(*tcp));
+  if (!tcp) { closesocket(sock); continue; }
+  tcp->sock = sock; tcp->dst = remote; tcp->incoming = true; tcp->incoming_so = listener != impl->tcp_listener; tcp->state = TCP_STATE_CONNECTED;
+  tcp->auth_deadline = current_timestamp() + STUN_TCP_TIMEOUT;
+  mutex_lock(&impl->send_mutex);
+  tcp->next = impl->tcp_connections; impl->tcp_connections = tcp; ++impl->tcp_revision;
+  mutex_unlock(&impl->send_mutex);
+ }
+}
