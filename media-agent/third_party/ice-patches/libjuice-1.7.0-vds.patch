+static void conn_poll_tcp_maintain(juice_agent_t *agent, timestamp_t now) {
+ conn_impl_t *impl = agent->conn_impl;
+ for (tcp_connection_t *tcp = impl->tcp_connections; tcp; tcp = tcp->next)
+  if (tcp->sock != INVALID_SOCKET && tcp->auth_deadline && now >= tcp->auth_deadline)
+   conn_poll_change_tcp_fail(agent, tcp);
+ mutex_lock(&impl->send_mutex);
+ tcp_connection_t **link = &impl->tcp_connections;
+ while (*link) {
+  tcp_connection_t *tcp = *link;
+  if (tcp->sock == INVALID_SOCKET) { *link = tcp->next; free(tcp); ++impl->tcp_revision; }
+  else link = &tcp->next;
+ }
+ mutex_unlock(&impl->send_mutex);
+}
