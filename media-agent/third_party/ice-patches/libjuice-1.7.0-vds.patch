+ // probe. Reuse the existing auxiliary pool across actual IPv4 interfaces
+ // instead, while respecting an explicitly bound interface.
+ if (!udp_get_bound_addr(impl->udp_sock, &bound) && addr_is_any((const struct sockaddr *)&bound.addr)) {
+  for (int i = 0; i < agent->local.candidates_count; ++i) {
+   const ice_candidate_t *candidate = &agent->local.candidates[i];
+   if (candidate->type != ICE_CANDIDATE_TYPE_HOST || candidate->transport != ICE_CANDIDATE_TRANSPORT_UDP ||
+       candidate->resolved.addr.ss_family != AF_INET) continue;
+   unsigned j;
+   for (j = 0; j < base_count; ++j)
+    if (addr_record_is_equal(&bases[j]->resolved, &candidate->resolved, false)) break;
+   if (j == base_count) bases[base_count++] = candidate;
+  }
