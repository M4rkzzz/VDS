+ int count = udp_get_addrs(impl->udp_sock, records, size);
+ for (int i = 0; i < count; ++i) {
+  records[i].socktype = SOCK_STREAM;
+  addr_set_port((struct sockaddr *)&records[i].addr, impl->tcp_port);
+ }
+ return count;
+}
