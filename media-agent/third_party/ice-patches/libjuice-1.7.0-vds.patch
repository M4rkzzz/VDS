+    ice_candidate_t *before = groups[j - 1];
+    unsigned a = vds_nat_exploration_rank(value->vds_nat_mode);
+    unsigned b = vds_nat_exploration_rank(before->vds_nat_mode);
+    uint32_t va = ntohl(((struct sockaddr_in *)&value->resolved.addr)->sin_addr.s_addr);
+    uint32_t vb = ntohl(((struct sockaddr_in *)&before->resolved.addr)->sin_addr.s_addr);
+    if (!(a < b || (a == b && (value->priority > before->priority ||
+        (value->priority == before->priority && va < vb))))) break;
+    groups[j] = before; --j;
+   }
