+static void conn_poll_tcp_listen(juice_agent_t *agent, conn_impl_t *impl, const udp_socket_config_t *config) {
+ (void)agent;
+ addr_record_t local; memset(&local, 0, sizeof(local)); local.len = sizeof(local.addr);
+ if (getsockname(impl->udp_sock, (struct sockaddr *)&local.addr, &local.len)) return;
+ socket_t sock = socket(local.addr.ss_family, SOCK_STREAM, IPPROTO_TCP);
+ if (sock == INVALID_SOCKET) return;
+ if (local.addr.ss_family == AF_INET6) {
+  const sockopt_t disabled = 0;
+  setsockopt(sock, IPPROTO_IPV6, IPV6_V6ONLY, (const char *)&disabled, sizeof(disabled));
+ }
+ ctl_t nbio = 1;
+ if (ioctlsocket(sock, FIONBIO, &nbio)) { closesocket(sock); return; }
+ if (bind(sock, (struct sockaddr *)&local.addr, local.len)) {
+  // Keep an explicitly configured port range. Otherwise a TCP port already in
+  // use must not disable direct TCP just because its UDP port was available.
+  if (config->port_begin || config->port_end) { closesocket(sock); return; }
+  addr_set_port((struct sockaddr *)&local.addr, 0);
+  if (bind(sock, (struct sockaddr *)&local.addr, local.len)) { closesocket(sock); return; }
+ }
+ if (listen(sock, SOMAXCONN) || getsockname(sock, (struct sockaddr *)&local.addr, &local.len)) { closesocket(sock); return; }
+ impl->tcp_listener = sock; impl->tcp_port = addr_get_port((struct sockaddr *)&local.addr);
+}
