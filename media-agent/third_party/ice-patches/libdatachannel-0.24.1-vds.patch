+/**
+ * VDS ICE-to-DTLS startup handoff. MPL-2.0, like the surrounding transport.
+ */
+#ifndef RTC_IMPL_EARLY_DTLS_CALLBACK_H
+#define RTC_IMPL_EARLY_DTLS_CALLBACK_H
+
+#include "message.hpp"
+#include "utils.hpp"
+#include <algorithm>
+#include <vector>
+
+namespace rtc::impl {
+
+// Reuse the existing callback's recursive mutex: registration, replay and live
+// delivery are serialized without adding a lock to the media hot path.
+class EarlyDtlsCallback final : public synchronized_callback<message_ptr> {
+public:
+    explicit EarlyDtlsCallback(bool enabled = false) : mWaiting(enabled) {}
+    using synchronized_callback<message_ptr>::operator=;
+
+private:
+    void set(message_callback func) override {
+        synchronized_callback<message_ptr>::set(std::move(func));
+        mWaiting = false; // unregister/stop must never re-arm startup buffering
+        auto pending = std::move(mPending);
+        mPending.clear();
+        mBytes = 0;
+        for (auto &message : pending) {
+            if (!callback) break;
+            synchronized_callback<message_ptr>::call(std::move(message));
+        }
+    }
+
+    bool call(message_ptr message) const override {
+        if (callback) return synchronized_callback<message_ptr>::call(std::move(message));
+        if (!mWaiting || !message || message->size() < 13) return false;
+        const auto *data = reinterpret_cast<const unsigned char *>(message->data());
+        // Only initial DTLS handshake records, never media or encrypted records.
+        // Certificate/fingerprint verification still belongs to the DTLS stack.
+        if (data[0] != 22 || data[1] != 0xfe || (data[2] != 0xfd && data[2] != 0xff) ||
+            data[3] != 0 || data[4] != 0) return false;
+        const size_t recordBytes = (size_t(data[11]) << 8) | data[12];
+        if (!recordBytes || recordBytes > message->size() - 13) return false;
+        for (const auto &saved : mPending)
+            if (saved->size() == message->size() && std::equal(saved->begin(), saved->end(), message->begin()))
+                return true;
+        // Bound only the pre-registration stash, not established transport traffic.
+        if (mPending.size() >= 16 || message->size() > 65536 - mBytes) return false;
+        mBytes += message->size();
+        mPending.push_back(std::move(message));
+        return true;
+    }
+
+    bool mWaiting;
+    mutable size_t mBytes = 0;
+    mutable std::vector<message_ptr> mPending;
+};
+
+} // namespace rtc::impl
+#endif
