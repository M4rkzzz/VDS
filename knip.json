{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "desktop/main.js",
    "desktop/preload.js",
    "desktop/window-metadata-helper.js",
    "server/public/app-state.js",
    "server/public/room-client.js",
    "server/public/debug-panel.js",
    "server/public/update-ui.js",
    "server/public/quality-settings.js",
    "server/public/source-selection.js",
    "server/public/app.js",
    "server/public/native/native-diagnostics.js",
    "server/public/native/native-stats-controller.js",
    "server/public/native/native-media-engine-controller.js",
    "server/public/native/p2p-state-machine.js",
    "server/public/native/native-surface-controller.js",
    "server/public/native/native-peer-controller.js",
    "server/public/native/native-peer-message-controller.js",
    "server/public/native/native-session-controller.js",
    "server/public/native/native-room-message-controller.js",
    "server/public/native/native-viewer-controls.js",
    "server/public/native/native-viewer-fullscreen-controls.js",
    "server/public/native/native-entry.js",
    "server/public/app-native-overrides.js",
    "vds_web/src/main.ts",
    "vds_web/src/vite-env.d.ts",
